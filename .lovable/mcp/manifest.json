{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fhlaqgzensagjangkpop.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "muktainagar-daily-mcp",
      "version": "0.1.0",
      "title": "Muktainagar Daily MCP"
    },
    "tools": [
      {
        "name": "search_shops",
        "title": "Search shops",
        "description": "Search the local business directory by name or description. Returns active shops with basic details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Text to match against shop name or description."
            },
            "city": {
              "description": "Optional city/taluka slug (e.g. 'muktainagar', 'bhusawal').",
              "type": "string"
            },
            "limit": {
              "description": "Max results (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_shop",
        "title": "Get shop details",
        "description": "Fetch full details for a single shop by its slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "The shop's URL slug."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List all active shop categories in the directory.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_bus_timetable",
        "title": "Get bus timetable",
        "description": "Fetch the bus timetable for the specified or default town, optionally filtered by destination.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "city": {
              "description": "Optional city/taluka slug (e.g. 'muktainagar', 'bhusawal', 'varangaon').",
              "type": "string"
            },
            "destination": {
              "description": "Optional destination filter (case-insensitive substring).",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_local_news",
        "title": "Get local news",
        "description": "Fetch latest active local news headlines and civic/agriculture/market updates for a town or taluka.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "city": {
              "description": "Optional city/taluka slug (e.g. 'maval', 'muktainagar', 'bhusawal').",
              "type": "string"
            },
            "category": {
              "description": "Optional news category filter.",
              "type": "string",
              "enum": [
                "local",
                "civic",
                "education",
                "agriculture",
                "markets",
                "sports",
                "alerts"
              ]
            },
            "limit": {
              "description": "Max articles to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_schools",
        "title": "Search schools & colleges",
        "description": "Search schools, junior/degree colleges, engineering/ITI institutes, coaching classes, admissions status, and live notices.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Optional name, board, stream, village, or keyword filter.",
              "type": "string"
            },
            "city": {
              "description": "Optional city/taluka slug (e.g. 'maval', 'muktainagar', 'bhusawal').",
              "type": "string"
            },
            "admission_status": {
              "description": "Optional admission status filter.",
              "type": "string",
              "enum": [
                "open",
                "ongoing",
                "upcoming",
                "closed"
              ]
            },
            "limit": {
              "description": "Max institutes (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_civic_services",
        "title": "Get civic alerts & helplines",
        "description": "Fetch active/scheduled water, electricity (MSEDCL), and municipal civic announcements plus official department helplines.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "city": {
              "description": "Optional city/taluka slug (e.g. 'maval', 'muktainagar', 'bhusawal').",
              "type": "string"
            },
            "department": {
              "description": "Optional civic department filter.",
              "type": "string",
              "enum": [
                "water",
                "electricity",
                "municipal"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
